{
  "name": "node-secure",
  "version": "1.0.0",
  "description": "NodeSecure Frontend Web Application - SafeZone startup",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "server": "json-server --watch server/db.json --routes server/routes.json --port 3000",
    "build:gh-pages": "ng build --base-href /NodeSecure-Frontend/ && node -e \"const f=require('fs');f.copyFileSync('dist/node-secure/browser/index.html','dist/node-secure/browser/404.html');f.writeFileSync('dist/node-secure/browser/.nojekyll','')\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^20.3.0",
    "eslint": "^9.36.0",
    "jasmine-core": "~5.9.0",
    "json-server": "0.17.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.45.0"
  }
}
